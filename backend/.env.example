PORT=8081
GIN_MODE=debug
JWT_SECRET=inventory-management-super-secure-jwt-key-2026

# PostgreSQL Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=inventory_db
DB_SSLMODE=disable

